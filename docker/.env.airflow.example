# Copy to .env.airflow and generate your own values. .env.airflow is gitignored.
#
# Fernet key — encrypts connection passwords stored in Airflow's database.
# Generate with:
#   python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW__CORE__FERNET_KEY=generate_your_own

# Signs the tokens running tasks use to call the API server. Any long random string.
AIRFLOW__API_AUTH__JWT_SECRET=generate_your_own

# The admin login created on first start. Change the password.
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=set_your_own_password
