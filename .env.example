# Copy to .env and set your own values. .env is gitignored — never commit it.
POSTGRES_USER=nova
POSTGRES_PASSWORD=set_your_own_password
POSTGRES_DB=nova

# Host-side connection (your Python scripts read these).
# Other containers in this compose project would use host "postgres" instead.
POSTGRES_HOST=localhost

# Host port only. Change it if 5432 is already taken on your machine —
# the container always listens on 5432 internally.
POSTGRES_PORT=5432
